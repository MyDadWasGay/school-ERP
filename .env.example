NEXT_PUBLIC_APP_NAME="School ERP"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:3001"
API_INTERNAL_BASE_URL="http://localhost:3001"
CONFIG_ENV="development"

# Fastify client API for the Next.js web frontend and Flutter. Render supplies
# PORT; local development may use 3001.
API_HOST="0.0.0.0"
API_PORT="3001"
API_PUBLIC_URL="https://your-school-erp.example.com"
API_CORS_ORIGINS="http://localhost:3000"

# Firebase web configuration is public application metadata, not a credential.
# Use values from the target Firebase project; never copy them from production.
NEXT_PUBLIC_FIREBASE_API_KEY="replace-with-firebase-web-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="replace-with-firebase-auth-domain"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="replace-with-firebase-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="replace-with-firebase-storage-bucket"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="replace-with-firebase-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="replace-with-firebase-app-id"

# Firebase Admin credentials belong in the hosting secret manager.
FIREBASE_PROJECT_ID="replace-with-firebase-project-id"
FIREBASE_CLIENT_EMAIL="replace-with-firebase-admin-client-email"
FIREBASE_PRIVATE_KEY="replace-with-firebase-private-key-from-secret-manager"

TURSO_DATABASE_URL="file:./.local/school-erp.db"
TURSO_AUTH_TOKEN="replace-with-turso-auth-token"

CLOUDINARY_CLOUD_NAME="replace-with-cloudinary-cloud-name"
CLOUDINARY_API_KEY="replace-with-cloudinary-api-key"
CLOUDINARY_API_SECRET="replace-with-cloudinary-api-secret"

APP_ENCRYPTION_SECRET="replace-with-a-random-secret-at-least-32-characters"
INTERNAL_JOB_SECRET="replace-with-a-different-random-secret-at-least-32-characters"

# Optional deployment-level provider defaults. Tenant-specific secrets are
# encrypted in integration_configs; these values remain in the secret manager.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
GOOGLE_CALENDAR_CLIENT_EMAIL=""
GOOGLE_CALENDAR_PRIVATE_KEY=""
GOOGLE_CALENDAR_ID=""
MOODLE_BASE_URL=""
MOODLE_TOKEN=""
TRACCAR_BASE_URL=""
TRACCAR_TOKEN=""

# Used only by `npm run db:seed:platform-admin`; never commit real values.
PLATFORM_ADMIN_EMAIL="admin@example.com"
PLATFORM_ADMIN_PASSWORD="replace-with-a-local-only-password"
PLATFORM_ADMIN_NAME="Platform Administrator"
