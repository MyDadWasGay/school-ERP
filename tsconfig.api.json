{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve"
  },
  "include": [
    "server/api/**/*.ts",
    "lib/auth/user-context.ts",
    "lib/auth/types.ts",
    "lib/auth/firebase-admin-core.ts",
    "lib/errors/app-error.ts",
    "db/**/*.ts",
    "config/**/*.ts"
  ]
}
