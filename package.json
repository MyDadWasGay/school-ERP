{
  "name": "school-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint app components config db features lib tests middleware.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --pool=threads --poolOptions.threads.singleThread",
    "test:watch": "vitest",
    "test:e2e": "node tests/run-e2e.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed:platform-admin": "tsx db/seed-platform-admin.ts",
    "db:inspect": "tsx db/inspect.ts",
    "db:backup": "node scripts/sqlite-backup.mjs",
    "db:restore": "node scripts/sqlite-restore.mjs",
    "jobs:worker": "node scripts/run-job-worker.mjs",
    "db:studio": "drizzle-kit studio",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:config": "node scripts/validate-config.mjs",
    "check": "npm run check:config && npm run check:secrets && npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
